# 서버 전용. 실제 값은 Supabase Secrets 및 로컬 .env.r2-migration.local에만 저장.
# VITE_ 변수, GitHub Pages, 확장 ZIP, 채팅에 비밀 키를 넣지 마세요.
SNS_MEDIA_BACKEND=r2
SNS_R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
SNS_R2_BUCKET=kudae-sns-assets
SNS_R2_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY
SNS_R2_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET_KEY
# 이전 스크립트만 사용. 해당 Supabase 프로젝트의 서버 키입니다.
SUPABASE_URL=https://bcqqokdehkfaiuquktag.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_KEY
