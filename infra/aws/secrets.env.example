SNS_AWS_REGION=ap-northeast-2
SNS_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
SNS_AWS_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_KEY_ID
SNS_AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SECRET
SNS_CLOUDFRONT_DOMAIN=REPLACE_WITH_DISTRIBUTION.cloudfront.net
SNS_CLOUDFRONT_KEY_PAIR_ID=REPLACE_WITH_PUBLIC_KEY_ID
# PEM line breaks can be entered as literal backslash-n; the server restores them.
SNS_CLOUDFRONT_PRIVATE_KEY=REPLACE_WITH_PRIVATE_PEM
